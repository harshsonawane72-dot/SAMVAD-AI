# ==============================================================================
# SAMVAD AI — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: DO NOT commit actual secrets or credentials to version control.
# Copy this file to '.env' and populate with your environment-specific values.
# ==============================================================================

# --- Server & Runtime Configuration ---
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins for FastAPI
# In production, specify exact frontend domains, e.g.: https://samvad.example.gov.in,https://admin.samvad.example.gov.in
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000

# --- Database Configuration ---
# Development: SQLite (default fallback)
# Production: PostgreSQL connection URI (e.g., postgresql+psycopg2://user:password@hostname:5432/samvad_db)
DATABASE_URL=sqlite:///backend/samvad.db

# --- Digital India BHASHINI Speech-to-Text (ASR) ---
# Optional: If unconfigured, the system automatically falls back to browser Web Speech API
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_INFERENCE_API_KEY=your_bhashini_inference_api_key_here
BHASHINI_PIPELINE_ID=64392f96daac503b137db368
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# --- AI & NLP Model Configuration ---
# Pretrained multilingual model for semantic representation and embeddings
INDICBERT_MODEL_NAME=ai4bharat/IndicBERTv2-MLM-only
# Path to trained risk classifier classification head weights
RISK_CLASSIFIER_WEIGHTS_PATH=backend/models/risk_classifier_head.pt

# --- Frontend API Base URL (Client-Side) ---
# In production, set window.SAMVAD_API_BASE_URL or configure reverse proxy routing
SAMVAD_API_BASE_URL=http://127.0.0.1:8000
